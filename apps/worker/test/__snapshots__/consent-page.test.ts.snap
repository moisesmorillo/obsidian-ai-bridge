// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`consent page rendering > renders escaped authorization details and protocol scopes 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Authorize Client &lt;script&gt; · Vaultwire</title><style>
:root{--base:#191724;--surface:#1f1d2e;--overlay:#26233a;--muted:#6e6a86;--subtle:#908caa;--text:#e0def4;--love:#eb6f92;--gold:#f6c177;--rose:#ebbcba;--pine:#31748f;--foam:#9ccfd8;--iris:#c4a7e7;--highlight-low:#21202e;--highlight-med:#403d52;--highlight-high:#524f67;color-scheme:dark;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--text);background:var(--base);font-size:14px;line-height:1.5}.owner-layout{display:flex;flex-wrap:wrap;gap:24px;min-height:100vh}.owner-sidebar{flex:1 1 240px;max-width:256px;padding:24px 0 24px 24px;background:var(--surface)}.brand{color:var(--text);font-size:20px;font-weight:700}.brand-mark{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--overlay);border:1px solid var(--highlight-med);color:var(--rose)}.owner-nav{display:flex;flex-direction:column;gap:8px;margin:28px 0}.owner-nav a{display:flex;align-items:center;min-height:40px;padding:0 12px;border:1px solid transparent;border-radius:12px;color:var(--subtle);text-decoration:none}.owner-nav a[aria-current=page],.owner-nav a[aria-current=location]{background:var(--overlay);border-color:color-mix(in srgb,var(--rose) 35%,transparent);color:var(--text)}.owner-main{display:flex;flex:999 1 560px;flex-direction:column;gap:28px;min-width:0;padding:36px 44px}h1,h2,p{margin-top:0}h1{margin-bottom:0;font-size:38px;line-height:1.1;letter-spacing:-.03em;color:var(--text)}h2{margin-bottom:0;font-size:16px;font-weight:600}.owner-eyebrow,.label{font-size:12px;color:var(--subtle)}.owner-eyebrow{margin-bottom:4px}.panel,.card{background:var(--surface);border:1px solid var(--highlight-med);border-radius:18px;padding:20px 22px}.panel{display:flex;flex-direction:column;gap:14px}.card-highlight{background:var(--overlay);border-color:color-mix(in srgb,var(--rose) 45%,transparent);box-shadow:0 0 40px color-mix(in srgb,var(--rose) 14%,transparent)}.table-scroll{max-width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%}th{font-size:12px;color:var(--subtle);text-align:left;white-space:nowrap}td,th{padding:14px 18px;border-bottom:1px solid color-mix(in srgb,var(--highlight-med) 60%,transparent);vertical-align:middle}td{white-space:nowrap}button,.button{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border:1px solid transparent;border-radius:12px;background:var(--rose);color:var(--base);font:600 14px/1 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;text-decoration:none;white-space:nowrap}button:hover,.button:hover{background:color-mix(in srgb,var(--rose) 85%,var(--text))}button:active,.button:active{background:var(--rose)}a{color:var(--rose)}button:disabled{opacity:.55}.button-secondary,button.button-secondary{background:transparent;border-color:var(--highlight-high);color:var(--text)}.button-danger,button.button-danger{background:transparent;border-color:color-mix(in srgb,var(--love) 45%,transparent);color:var(--love)}input:not([type=hidden]){height:40px;min-width:0;padding:0 16px;border:1px solid var(--highlight-med);border-radius:12px;background:var(--highlight-low);color:var(--text);font:400 14px/1.2 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}form{margin:0}.button-group{display:flex;align-items:baseline;gap:8px}.button-group form{display:flex;gap:8px;align-items:baseline}.button-small{height:32px;padding:0 12px;font-size:12px}.chip{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 12px;border:1px solid var(--highlight-med);border-radius:999px;color:var(--text);white-space:nowrap}.chip-stale{color:var(--gold);border-color:color-mix(in srgb,var(--gold) 45%,transparent)}.chip-fresh{color:var(--foam);border-color:var(--foam)}.stat-value.kind-agent{color:var(--iris)}.status-dot{display:inline-block;flex:0 0 9px;width:9px;height:9px;border-radius:50%;background:var(--muted);box-shadow:none}.status-dot-copper{background:var(--rose);box-shadow:0 0 10px var(--rose)}.owner-service{margin-top:32px;padding:16px;background:var(--overlay);border:1px solid var(--highlight-med);border-radius:18px}.owner-service p{margin:8px 0 0;color:var(--subtle);font-size:12px}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.page-header>div{min-width:0}.page-header h1{margin:4px 0 8px}.page-header p:last-child{margin-bottom:0}.stat-grid,.storage-grid,.identity-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.stat-grid .card,.storage-grid .card,.identity-grid .card{min-width:0}.stat-value{margin:8px 0;font-size:34px;font-weight:700;letter-spacing:-.03em;color:var(--text);overflow-wrap:anywhere}.label{margin:0;font-size:12px}.footnote,.measurement-note{margin:0;color:var(--subtle);font-size:12px}.unit{font-size:14px}.status-cell{display:inline-flex;align-items:center;gap:8px}.muted{color:var(--subtle)}.client-name{font-weight:700;color:var(--text)}.client-id{display:block;color:var(--subtle);font-size:12px}.client-actions{display:flex;align-items:baseline;gap:8px}.client-actions details{position:relative}.client-actions summary{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:1px solid var(--highlight-high);border-radius:12px;color:var(--text);cursor:pointer;list-style:none}.client-actions summary::-webkit-details-marker{display:none}.rename-form{display:flex;align-items:baseline;gap:8px;margin-top:8px}.danger-zone{display:flex;gap:8px;align-items:center;padding:8px;border:1px solid color-mix(in srgb,var(--love) 45%,transparent);background:color-mix(in srgb,var(--love) 12%,transparent);border-radius:12px}.danger-zone p{margin:0;color:var(--love);font-size:12px}.table-footnote{margin:0;color:var(--subtle);font-size:12px}.breadcrumb{color:var(--subtle);font-size:12px}.measurement-note{color:var(--text)}.unit{font-size:14px}.storage-bar{height:3px;margin:12px 0;background:color-mix(in srgb,var(--pine) 55%,transparent)}.storage-observed:after{display:block;width:16px;height:3px;background:var(--rose);content:""}.storage-unknown{background:color-mix(in srgb,var(--pine) 55%,transparent)}.slot-segments{display:flex;gap:6px}.slot-segment{height:8px;flex:1;border-radius:999px;border:1px solid color-mix(in srgb,var(--pine) 55%,transparent)}.slot-held{background:var(--rose);border-color:var(--rose)}.collection-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:0;list-style:none}.collection-step{padding:12px 8px;text-align:center;border:1px solid var(--highlight-med);border-radius:14px;color:var(--subtle)}.step-current{color:var(--text);border-color:color-mix(in srgb,var(--rose) 45%,transparent);background:var(--overlay);box-shadow:0 0 40px color-mix(in srgb,var(--rose) 14%,transparent)}.safety-panel{border-color:color-mix(in srgb,var(--rose) 45%,transparent)}.failed-list{list-style:none;padding:0;margin:0}.about-panel{background:var(--overlay)}.about-panel p{margin:0}.no-wrap{white-space:nowrap}.grant-state-revoked{color:var(--muted)}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;gap:0}.owner-sidebar{flex:1 1 100%;max-width:none;padding:16px 16px 0}.owner-nav{flex-direction:row;gap:8px;margin:16px 0;overflow-x:auto;white-space:nowrap}.owner-nav a{flex:0 0 auto}.owner-main{flex:1 1 100%;gap:20px;padding:16px}.card-grid,.stat-grid,.storage-grid,.identity-grid{grid-template-columns:1fr}.collection-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.page-header{flex-wrap:wrap}.table-scroll{overflow-x:auto}.owner-service{margin-top:16px}}

body.consent-page{display:grid;min-height:100vh;place-items:center;padding:24px}.consent-wrap{width:min(100%,560px)}.consent-brand{display:flex;align-items:center;gap:12px;margin:0 0 24px;color:var(--text)}.consent-brand-copy{display:grid}.consent-host{color:var(--subtle);font-size:12px}.consent-card{max-width:560px;background:var(--surface);border-color:var(--highlight-med);box-shadow:none}.consent-details{display:grid;gap:12px;margin:24px 0;padding:16px;background:var(--overlay);border:1px solid var(--highlight-med);border-radius:12px}.consent-details div{display:grid;grid-template-columns:140px minmax(0,1fr);gap:12px}.consent-details dt{color:var(--subtle);font-size:12px}.consent-details dd{margin:0;overflow-wrap:anywhere}.consent-scopes{display:grid;gap:10px;margin:8px 0 0;padding:0;list-style:none}.consent-scopes li{min-width:0}.consent-scope-copy{display:grid;gap:2px;min-width:0}.consent-scope-name{font-weight:600}.consent-scope-description{color:var(--subtle);font-size:12px}.consent-form{display:grid;gap:16px;margin-top:12px}.consent-form label{display:grid;gap:6px}.consent-form input{padding:10px;border:1px solid var(--highlight-med);border-radius:12px;background:var(--highlight-low);color:var(--text)}.consent-form .consent-scope{display:flex;align-items:flex-start;gap:12px}.consent-scopes input[type="checkbox"]{appearance:auto;flex:0 0 18px;width:18px;height:18px;margin:1px 0 0;padding:0;border:0;border-radius:2px;background:transparent;accent-color:var(--rose);cursor:pointer}.consent-scopes input[type="checkbox"]:disabled{cursor:not-allowed}.consent-scopes input[type="checkbox"]:focus{outline:2px solid var(--rose);outline-offset:3px}.consent-actions{display:flex;justify-content:flex-end;gap:10px}.consent-deny{order:0;border:1px solid var(--highlight-high);background:transparent;color:var(--text)}.consent-deny:hover,.consent-deny:active{background:transparent;border-color:var(--highlight-high);color:var(--text)}.consent-actions button[name="decision"][value="approve"]{order:1}.consent-footer{margin-top:20px;color:var(--subtle);font-size:12px}@media(max-width:560px){body.consent-page{padding:16px}.consent-details div{grid-template-columns:1fr;gap:2px}.consent-actions{flex-direction:column}.consent-actions button{width:100%}}</style></head><body class="consent-page"><div class="consent-wrap"><header class="consent-brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12h6l2-6 4 12 2-6h2"/></svg></span><span class="consent-brand-copy"><strong>Vaultwire</strong><span class="consent-host">service.test&amp;host</span></span></header><main class="card card-highlight consent-card"><p class="owner-eyebrow">Authorization request</p><h1>Authorize Client &lt;script&gt;</h1><p>Review the requested permissions before you continue.</p><dl class="consent-details"><div><dt>Application</dt><dd>Client &lt;script&gt;</dd></div><div><dt>Redirect URI</dt><dd>https://client.test/callback?a=1&amp;b=2</dd></div><div><dt>Requested on</dt><dd>Nov 7, 2026 at 9:30 PM</dd></div></dl><h2>Permissions requested</h2><form class="consent-form" method="post" action="/authorize/consent"><input type="hidden" name="handle" value="handle&amp;value"><ul class="consent-scopes"><li><label class="consent-scope"><input type="checkbox" checked disabled aria-label="vault:read is required"><input type="hidden" name="scope" value="vault:read"><span class="consent-scope-copy"><span class="consent-scope-name">vault:read</span><span class="consent-scope-description">read notes (needed)</span></span></label></li><li><label class="consent-scope"><input type="checkbox" name="scope" value="vault:write" checked><span class="consent-scope-copy"><span class="consent-scope-name">vault:write</span><span class="consent-scope-description">create and edit notes</span></span></label></li><li><label class="consent-scope"><input type="checkbox" name="scope" value="vault:delete" checked><span class="consent-scope-copy"><span class="consent-scope-name">vault:delete</span><span class="consent-scope-description">delete notes</span></span></label></li></ul><label>Client name <input name="client_name" maxlength="80"></label><div class="consent-actions"><button name="decision" value="approve">Approve access</button><button class="consent-deny" name="decision" value="deny">Deny</button></div></form></main><footer class="consent-footer">Protected by Cloudflare Access. Revoke later from Connected clients.</footer></div></body></html>"
`;
