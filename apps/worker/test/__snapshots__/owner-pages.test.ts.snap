"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Owner console</title><style>
:root{--bg: #080506;--wine-900: #1A0810;--wine-700: #4E0E1F;--wine-500: #962042;--wine-300: #F29AB4;--copper: #E08A5F;--copper-light: #F0AB8A;--copper-dark: #B86038;--text: #F2ECEA;--text-strong: #FAF4F0;--text-soft: #D2BDC1;--text-muted: #AE8F96;--danger: #FF9B9B;color-scheme:dark;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--text);background:radial-gradient(1200px 640px at 10% 0%,#4E0E1F 0%,#1A0810 42%,#080506 100%);background-attachment:fixed;font-size:14px;line-height:1.5}.owner-layout{display:flex;flex-wrap:wrap;gap:32px;min-height:100vh;padding:24px}.owner-sidebar{flex:1 1 240px;max-width:256px}.brand{color:var(--text-strong);font-size:20px;font-weight:700}.brand-mark{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--copper);color:var(--wine-900)}.owner-nav{display:flex;flex-direction:column;gap:8px;margin:28px 0}.owner-nav a,.chip{padding:10px 12px;border-radius:12px;color:var(--text-soft);text-decoration:none}.owner-nav a[aria-current=page]{background:rgba(78,14,31,.55);border:1px solid rgba(224,138,95,.35);color:var(--text-strong)}.owner-main{flex:999 1 560px;min-width:0;padding:36px 44px}h1{font-size:38px;line-height:1.1;letter-spacing:-.03em;color:var(--text-strong)}h2{font-size:16px}.owner-eyebrow,.label{font-size:12px;color:var(--text-muted)}.panel,.card{background:rgba(78,14,31,.28);border:1px solid rgba(150,32,66,.45);border-radius:18px;padding:20px}.card-highlight{background:rgba(78,14,31,.5);border-color:rgba(224,138,95,.45);box-shadow:0 0 40px rgba(224,138,95,.14)}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%}th{font-size:12px;color:var(--text-muted);text-align:left}td,th{padding:12px;border-bottom:1px solid rgba(150,32,66,.16)}button,.button{border:0;border-radius:12px;padding:10px 14px;background:linear-gradient(180deg,var(--copper),var(--copper-dark));color:#1A0810;font:inherit;font-weight:700}a{color:var(--copper-light)}button:disabled{opacity:.55}.chip{display:inline-flex;border:1px solid rgba(150,32,66,.45);border-radius:999px}.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--copper);box-shadow:0 0 10px var(--copper)}.danger-zone{border:1px solid rgba(255,140,140,.35);background:rgba(60,10,14,.55);border-radius:18px}.owner-service{margin-top:32px;padding:16px;background:rgba(26,8,16,.78);border:1px solid rgba(150,32,66,.35);border-radius:18px}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:20px}.page-header h1{margin:4px 0 8px}.stat-grid,.storage-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin:20px 0}.stat-value{font-size:34px;font-weight:700;letter-spacing:-.03em;color:var(--text-strong);margin:8px 0;overflow-wrap:anywhere}.label{margin:0}.footnote,.measurement-note{color:var(--text-soft);font-size:13px}.unit{font-size:14px}.button-secondary,button.button-secondary{display:inline-block;padding:8px 12px;border:1px solid rgba(150,32,66,.6);border-radius:12px;color:var(--text-strong);text-decoration:none;background:rgba(26,8,16,.45);font:inherit;font-weight:600}.storage-bar{height:3px;margin:12px 0;background:rgba(150,32,66,.45)}.storage-observed:after{display:block;width:16px;height:3px;background:var(--copper);content:""}.storage-unknown{background:rgba(150,32,66,.25)}.slot-segments{display:flex;gap:6px}.slot-segment{height:8px;flex:1;border-radius:999px;border:1px solid rgba(150,32,66,.6)}.slot-held{background:var(--copper);border-color:var(--copper)}.status-dot-copper{background:var(--copper);box-shadow:0 0 10px var(--copper)}.collection-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:0;list-style:none}.collection-step{padding:12px 8px;text-align:center;border:1px solid rgba(150,32,66,.45);border-radius:12px;color:var(--text-muted)}.step-current{color:var(--text-strong);border-color:rgba(224,138,95,.45);background:rgba(78,14,31,.5);box-shadow:0 0 40px rgba(224,138,95,.14)}.safety-panel{border-color:rgba(224,138,95,.45)}.failed-list{list-style:none;padding:0}.muted{color:var(--text-muted)}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;padding:16px}.owner-sidebar{flex:1 1 100%;max-width:none}.owner-nav{flex-direction:row;overflow-x:auto;white-space:nowrap}.owner-main{flex:1 1 100%;padding:16px}.card-grid,.stat-grid,.storage-grid{grid-template-columns:1fr}.collection-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.page-header{flex-wrap:wrap}.table-scroll{overflow-x:auto}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients" aria-current="location">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Exports</a><a href="/owner/blob-gc">Blob collection</a></nav><section class="owner-service"><h2>Service</h2><p><span class="status-dot" aria-hidden="true"></span> Service metadata unknown</p></section></aside><main class="owner-main"><p class="owner-eyebrow">Clients / id&lt;&amp;</p><h1>Client grants</h1><div class="table-scroll"><table><thead><tr><th>Grant</th><th>Registry state</th><th>Provider cleanup</th></tr></thead><tbody><tr><td>grant&lt;&amp;</td><td><span class="chip">Active registry grant</span></td><td>provider cleanup not pending</td></tr><tr><td>grant-2</td><td><span class="chip">Revoked</span></td><td>provider cleanup pending</td></tr></tbody></table></div><a href="/owner/clients/id%3C%26/grants?cursor=a%26b">Next page</a></main></div></body></html>"
`;

exports[`owner page rendering > renders measurements with explicit unknowns and preserved measurement facts 1`] = `
