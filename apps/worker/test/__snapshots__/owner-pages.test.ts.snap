,.14)}.safety-panel{border-color:rgba(224,138,95,.45)}.failed-list{list-style:none;padding:0;margin:0}.about-panel p{margin:0}.no-wrap{white-space:nowrap}.grant-state-revoked{color:var(--text-muted)}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;gap:0}.owner-sidebar{flex:1 1 100%;max-width:none;padding:16px 16px 0}.owner-nav{flex-direction:row;gap:8px;margin:16px 0;overflow-x:auto;white-space:nowrap}.owner-nav a{flex:0 0 auto}.owner-main{flex:1 1 100%;gap:20px;padding:16px}.card-grid,.stat-grid,.storage-grid,.identity-grid{grid-template-columns:1fr}.collection-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.page-header{flex-wrap:wrap}.table-scroll{overflow-x:auto}.owner-service{margin-top:16px}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients" aria-current="page">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Backups</a><a href="/owner/blob-gc">Blob cleanup</a></nav><section class="owner-service"><h2>Service</h2><p><span class="label">Worker</span> 0.3.0</p></section></aside><main class="owner-main"><header class="page-header"><div><p class="owner-eyebrow">Registry</p><h1>Connected clients</h1><p>Manage registered clients and retained grant history.</p></div></header><section class="stat-grid" aria-label="Listed-page registry totals"><article class="card"><p class="label">Active grants on listed page</p><p class="stat-value">0</p><p class="footnote">Listed client page only.</p></article><article class="card"><p class="label">Revoked grants on listed page</p><p class="stat-value">2</p><p class="footnote">Listed client page only.</p></article><article class="card"><p class="label">Cleanup pending on listed page</p><p class="stat-value">1</p><p class="footnote">Listed client page only.</p></article></section><section class="panel"><div class="table-scroll"><table><thead><tr><th>Client</th><th>Kind</th><th>Grants</th><th>State</th><th>Actions</th></tr></thead><tbody><tr><td><span class="client-name">&lt;script&gt;</span><span class="client-id">id&lt;&amp;</span></td><td>Unknown</td><td><span>0</span> <a class="button-secondary button-small" href="/owner/clients/id%3C%26/grants">View</a></td><td><span class="status-cell"><span class="status-dot" aria-hidden="true"></span>Revoked</span></td><td><div class="client-actions"><details><summary>Rename</summary><form class="rename-form" method="post" action="/owner/clients/id%3C%26/rename"><input type="hidden" name="csrf" value="state-1"><label class="muted">Name <input name="name" maxlength="80" value="&lt;script&gt;"></label><button>Rename</button></form></details><form method="post" action="/owner/clients/id%3C%26/revoke"><input type="hidden" name="csrf" value="state-1"><button class="button-danger">Revoke</button></form><div class="danger-zone"><form method="post" action="/owner/clients/id%3C%26/remove"><input type="hidden" name="csrf" value="state-1"><button class="button-danger" disabled>Remove</button></form><p>Complete provider cleanup before removal.</p></div></div></td></tr></tbody></table></div><p class="table-footnote">Grant counts show retained grant history. Active registry grants do not prove that provider tokens are current or unexpired.</p></section><a href="/owner/clients?cursor=a%26b">Next page</a></main></div></body></html>"
`;

exports[`owner page rendering > renders export forms, completed links, retained summary, and empty failures 1`] = `
