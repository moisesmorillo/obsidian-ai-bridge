10,14,.55);border-radius:18px}.owner-service{margin-top:32px;padding:16px;background:rgba(26,8,16,.78);border:1px solid rgba(150,32,66,.35);border-radius:18px}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;padding:16px}.owner-sidebar{flex:1 1 100%;max-width:none}.owner-nav{flex-direction:row;overflow-x:auto;white-space:nowrap}.owner-main{flex:1 1 100%;padding:16px}.card-grid{grid-template-columns:1fr}.table-scroll{overflow-x:auto}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients" aria-current="page">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Exports</a><a href="/owner/blob-gc">Blob collection</a></nav><section class="owner-service"><h2>Service</h2><p><span class="status-dot" aria-hidden="true"></span> Service metadata unknown</p></section></aside><main class="owner-main"><h1>Connected clients</h1></main></div></body></html>"
