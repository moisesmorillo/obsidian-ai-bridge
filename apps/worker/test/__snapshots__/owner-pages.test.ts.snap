exports[`owner page rendering > renders blob cleanup safety, current phase, form, and unavailable inventory 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Owner console</title><style>
:root{--bg:#080506;--wine-900:#1A0810;--wine-700:#4E0E1F;--wine-500:#962042;--wine-300:#F29AB4;--copper:#E08A5F;--copper-light:#F0AB8A;--copper-dark:#B86038;--text:#F2ECEA;--text-strong:#FAF4F0;--text-soft:#D2BDC1;--text-muted:#AE8F96;--danger:#FF9B9B;color-scheme:dark;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--text);background:radial-gradient(1200px 640px at 10% 0%,#4E0E1F 0%,#1A0810 42%,#080506 100%);background-attachment:fixed;font-size:14px;line-height:1.5}.owner-layout{display:flex;flex-wrap:wrap;gap:24px;min-height:100vh}.owner-sidebar{flex:1 1 240px;max-width:256px;padding:24px 0 24px 24px}.brand{color:var(--text-strong);font-size:20px;font-weight:700}.brand-mark{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--copper);color:var(--wine-900)}.owner-nav{display:flex;flex-direction:column;gap:8px;margin:28px 0}.owner-nav a{display:flex;align-items:center;min-height:40px;padding:0 12px;border:1px solid transparent;border-radius:12px;color:var(--text-soft);text-decoration:none}.owner-nav a[aria-current=page],.owner-nav a[aria-current=location]{background:rgba(78,14,31,.55);border-color:rgba(224,138,95,.35);color:var(--text-strong)}.owner-main{display:flex;flex:999 1 560px;flex-direction:column;gap:28px;min-width:0;padding:36px 44px}h1,h2,p{margin-top:0}h1{margin-bottom:0;font-size:38px;line-height:1.1;letter-spacing:-.03em;color:var(--text-strong)}h2{margin-bottom:0;font-size:16px;font-weight:600}.owner-eyebrow,.label{font-size:12px;color:var(--text-muted)}.owner-eyebrow{margin-bottom:4px}.panel,.card{background:rgba(78,14,31,.28);border:1px solid rgba(150,32,66,.45);border-radius:18px;padding:20px 22px}.panel{display:flex;flex-direction:column;gap:14px}.card-highlight{background:rgba(78,14,31,.5);border-color:rgba(224,138,95,.45);box-shadow:0 0 40px rgba(224,138,95,.14)}.table-scroll{max-width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%}th{font-size:12px;color:var(--text-muted);text-align:left;white-space:nowrap}td,th{padding:14px 18px;border-bottom:1px solid rgba(150,32,66,.16);vertical-align:middle}td{white-space:nowrap}button,.button{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border:1px solid transparent;border-radius:12px;background:linear-gradient(180deg,var(--copper),var(--copper-dark));color:#1A0810;font:600 14px/1 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;text-decoration:none;white-space:nowrap}a{color:var(--copper-light)}button:disabled{opacity:.55}.button-secondary,button.button-secondary{background:transparent;border-color:rgba(150,32,66,.6);color:var(--text-strong)}.button-danger,button.button-danger{background:transparent;border-color:rgba(255,140,140,.35);color:var(--danger)}input:not([type=hidden]){height:40px;min-width:0;padding:0 16px;border:1px solid rgba(150,32,66,.6);border-radius:12px;background:rgba(8,5,6,.6);color:var(--text-strong);font:400 14px/1.2 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}form{margin:0}.button-group{display:flex;align-items:baseline;gap:8px}.button-group form{display:flex;gap:8px;align-items:baseline}.button-small{height:32px;padding:0 12px;font-size:12px}.chip{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 12px;border:1px solid rgba(150,32,66,.45);border-radius:999px;color:var(--text-soft);white-space:nowrap}.status-dot{display:inline-block;flex:0 0 9px;width:9px;height:9px;border-radius:50%;background:#6B4A52;box-shadow:none}.status-dot-copper{background:var(--copper);box-shadow:0 0 10px var(--copper)}.owner-service{margin-top:32px;padding:16px;background:rgba(26,8,16,.78);border:1px solid rgba(150,32,66,.35);border-radius:18px}.owner-service p{margin:8px 0 0;color:var(--text-soft);font-size:12px}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.page-header>div{min-width:0}.page-header h1{margin:4px 0 8px}.page-header p:last-child{margin-bottom:0}.stat-grid,.storage-grid,.identity-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.stat-grid .card,.storage-grid .card,.identity-grid .card{min-width:0}.stat-value{margin:8px 0;font-size:34px;font-weight:700;letter-spacing:-.03em;color:var(--text-strong);overflow-wrap:anywhere}.label{margin:0;font-size:12px}.footnote,.measurement-note{margin:0;color:var(--text-muted);font-size:12px}.unit{font-size:14px}.status-cell{display:inline-flex;align-items:center;gap:8px}.muted{color:var(--text-muted)}.client-name{font-weight:700;color:var(--text-strong)}.client-id{display:block;color:var(--text-muted);font-size:12px}.client-actions{display:flex;align-items:baseline;gap:8px}.client-actions details{position:relative}.client-actions summary{display:inline-flex;align-items:center;height:40px;padding:0 16px;border:1px solid rgba(150,32,66,.6);border-radius:12px;color:var(--text-strong);cursor:pointer;list-style:none}.client-actions summary::-webkit-details-marker{display:none}.rename-form{display:flex;align-items:baseline;gap:8px;margin-top:8px}.danger-zone{display:flex;gap:8px;align-items:center;padding:8px;border:1px solid rgba(255,140,140,.35);background:rgba(60,10,14,.55);border-radius:12px}.danger-zone p{margin:0;color:var(--danger);font-size:12px}.table-footnote{margin:0;color:var(--text-muted);font-size:12px}.breadcrumb{color:var(--text-muted);font-size:12px}.measurement-note{color:var(--text-soft)}.unit{font-size:14px}.storage-bar{height:3px;margin:12px 0;background:rgba(150,32,66,.45)}.storage-observed:after{display:block;width:16px;height:3px;background:var(--copper);content:""}.storage-unknown{background:rgba(150,32,66,.25)}.slot-segments{display:flex;gap:6px}.slot-segment{height:8px;flex:1;border-radius:999px;border:1px solid rgba(150,32,66,.6)}.slot-held{background:var(--copper);border-color:var(--copper)}.collection-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:0;list-style:none}.collection-step{padding:12px 8px;text-align:center;border:1px solid rgba(150,32,66,.45);border-radius:14px;color:var(--text-muted)}.step-current{color:var(--text-strong);border-color:rgba(224,138,95,.45);background:rgba(78,14,31,.5);box-shadow:0 0 40px rgba(224,138,95,.14)}.safety-panel{border-color:rgba(224,138,95,.45)}.failed-list{list-style:none;padding:0;margin:0}.about-panel p{margin:0}.no-wrap{white-space:nowrap}.grant-state-revoked{color:var(--text-muted)}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;gap:0}.owner-sidebar{flex:1 1 100%;max-width:none;padding:16px 16px 0}.owner-nav{flex-direction:row;gap:8px;margin:16px 0;overflow-x:auto;white-space:nowrap}.owner-nav a{flex:0 0 auto}.owner-main{flex:1 1 100%;gap:20px;padding:16px}.card-grid,.stat-grid,.storage-grid,.identity-grid{grid-template-columns:1fr}.collection-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.page-header{flex-wrap:wrap}.table-scroll{overflow-x:auto}.owner-service{margin-top:16px}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Backups</a><a href="/owner/blob-gc" aria-current="page">Blob cleanup</a></nav><section class="owner-service"><h2>Service</h2><p><span class="label">Worker</span> 0.3.0</p></section></aside><main class="owner-main"><header class="page-header"><div><p class="owner-eyebrow">Storage</p><h1>Blob cleanup</h1><p>Review unreferenced blob inventory and run one bounded collection batch.</p></div><span class="chip"><span class="status-dot status-dot-copper" aria-hidden="true"></span>deleting</span></header><section class="stat-grid" aria-label="Blob collection observations"><article class="card"><p class="label">Unreferenced blobs</p><p class="stat-value"><span class="muted">unavailable</span></p></article><article class="card"><p class="label">Reclaimable bytes</p><p class="stat-value"><span class="muted">unavailable</span></p></article><article class="card"><p class="label">Run phase</p><p class="stat-value"><span class="status-dot status-dot-copper" aria-hidden="true"></span> deleting</p><p class="footnote">Marked blobs: 2. Marked bytes: under 0.1 MB.</p></article></section><section class="panel"><h2>Collection run</h2><p>Dry run unavailable.</p><ol class="collection-steps"><li class="collection-step">Inventory</li><li class="collection-step">Mark</li><li class="collection-step step-current" aria-current="step">Delete</li><li class="collection-step">Clear</li></ol><p>Marked counts: 2 blobs, under 0.1 MB.</p><p>Delete outcome is unknown. Marks and publication remain blocked. An owner retry cannot clear this claim. Collection failed. Marks remain for a retry.</p><form method="post" action="/owner/blob-gc"><input type="hidden" name="csrf" value="gc-csrf"><button class="button-secondary">Confirm or continue blob collection</button></form><p>Each request and alarm handles one bounded batch.</p></section><section class="panel safety-panel"><h2>Collection safety</h2><p>Backups are excluded. The mark fence protects published blobs.</p></section></main></div></body></html>"
`;

