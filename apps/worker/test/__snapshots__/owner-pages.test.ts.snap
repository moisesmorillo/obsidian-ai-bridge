exports[`owner page rendering > renders client states, protected actions, and empty state 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Owner console</title><style>
:root{--bg: #080506;--wine-900: #1A0810;--wine-700: #4E0E1F;--wine-500: #962042;--wine-300: #F29AB4;--copper: #E08A5F;--copper-light: #F0AB8A;--copper-dark: #B86038;--text: #F2ECEA;--text-strong: #FAF4F0;--text-soft: #D2BDC1;--text-muted: #AE8F96;--danger: #FF9B9B;color-scheme:dark;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--text);background:radial-gradient(1200px 640px at 10% 0%,#4E0E1F 0%,#1A0810 42%,#080506 100%);background-attachment:fixed;font-size:14px;line-height:1.5}.owner-layout{display:flex;flex-wrap:wrap;gap:32px;min-height:100vh;padding:24px}.owner-sidebar{flex:1 1 240px;max-width:256px}.brand{color:var(--text-strong);font-size:20px;font-weight:700}.brand-mark{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--copper);color:var(--wine-900)}.owner-nav{display:flex;flex-direction:column;gap:8px;margin:28px 0}.owner-nav a,.chip{padding:10px 12px;border-radius:12px;color:var(--text-soft);text-decoration:none}.owner-nav a[aria-current=page]{background:rgba(78,14,31,.55);border:1px solid rgba(224,138,95,.35);color:var(--text-strong)}.owner-main{flex:999 1 560px;min-width:0;padding:36px 44px}h1{font-size:38px;line-height:1.1;letter-spacing:-.03em;color:var(--text-strong)}h2{font-size:16px}.owner-eyebrow,.label{font-size:12px;color:var(--text-muted)}.panel,.card{background:rgba(78,14,31,.28);border:1px solid rgba(150,32,66,.45);border-radius:18px;padding:20px}.card-highlight{background:rgba(78,14,31,.5);border-color:rgba(224,138,95,.45);box-shadow:0 0 40px rgba(224,138,95,.14)}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%}th{font-size:12px;color:var(--text-muted);text-align:left}td,th{padding:12px;border-bottom:1px solid rgba(150,32,66,.16)}button,.button{border:0;border-radius:12px;padding:10px 14px;background:linear-gradient(180deg,var(--copper),var(--copper-dark));color:#1A0810;font:inherit;font-weight:700}a{color:var(--copper-light)}button:disabled{opacity:.55}.chip{display:inline-flex;border:1px solid rgba(150,32,66,.45);border-radius:999px}.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--copper);box-shadow:0 0 10px var(--copper)}.danger-zone{border:1px solid rgba(255,140,140,.35);background:rgba(60,10,14,.55);border-radius:18px}.owner-service{margin-top:32px;padding:16px;background:rgba(26,8,16,.78);border:1px solid rgba(150,32,66,.35);border-radius:18px}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;padding:16px}.owner-sidebar{flex:1 1 100%;max-width:none}.owner-nav{flex-direction:row;overflow-x:auto;white-space:nowrap}.owner-main{flex:1 1 100%;padding:16px}.card-grid{grid-template-columns:1fr}.table-scroll{overflow-x:auto}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients" aria-current="page">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Exports</a><a href="/owner/blob-gc">Blob collection</a></nav><section class="owner-service"><h2>Service</h2><p><span class="status-dot" aria-hidden="true"></span> Service metadata unknown</p></section></aside><main class="owner-main"><p class="owner-eyebrow">Registry</p><h1>Connected clients</h1><p>Manage registered clients and retained grant history.</p><p><a href="/owner/measurements?format=html">Service measurements</a> <a href="/owner/blob-gc">Collect unreferenced blobs</a></p><section class="card-grid"><article class="card"><h2>&lt;script&gt;</h2><p>Client: id&lt;&amp;</p><p>Registry state: Revoked</p><p>1 provider cleanup pending</p><p>Grant counts show retained grant history. Active registry grants do not prove that provider tokens are current or unexpired.</p><a href="/owner/clients/id%3C%26/grants">View grants (2)</a><form method="post" action="/owner/clients/id%3C%26/rename"><input type="hidden" name="csrf" value="state-1"><label>Name <input name="name" maxlength="80" value="&lt;script&gt;"></label><button>Rename</button></form><form method="post" action="/owner/clients/id%3C%26/revoke"><input type="hidden" name="csrf" value="state-1"><button>Revoke</button></form><form method="post" action="/owner/clients/id%3C%26/remove"><input type="hidden" name="csrf" value="state-1"><button disabled>Remove</button></form><p>Use Revoke to complete provider cleanup before removal.</p></article></section><a href="/owner/clients?cursor=a%26b">Next page</a></main></div></body></html>"
`;

exports[`owner page rendering > renders grant states, encoded pagination, and empty state 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Owner console</title><style>
:root{--bg: #080506;--wine-900: #1A0810;--wine-700: #4E0E1F;--wine-500: #962042;--wine-300: #F29AB4;--copper: #E08A5F;--copper-light: #F0AB8A;--copper-dark: #B86038;--text: #F2ECEA;--text-strong: #FAF4F0;--text-soft: #D2BDC1;--text-muted: #AE8F96;--danger: #FF9B9B;color-scheme:dark;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--text);background:radial-gradient(1200px 640px at 10% 0%,#4E0E1F 0%,#1A0810 42%,#080506 100%);background-attachment:fixed;font-size:14px;line-height:1.5}.owner-layout{display:flex;flex-wrap:wrap;gap:32px;min-height:100vh;padding:24px}.owner-sidebar{flex:1 1 240px;max-width:256px}.brand{color:var(--text-strong);font-size:20px;font-weight:700}.brand-mark{display:inline-grid;place-items:center;width:36px;height:36px;margin-right:10px;border-radius:10px;background:var(--copper);color:var(--wine-900)}.owner-nav{display:flex;flex-direction:column;gap:8px;margin:28px 0}.owner-nav a,.chip{padding:10px 12px;border-radius:12px;color:var(--text-soft);text-decoration:none}.owner-nav a[aria-current=page]{background:rgba(78,14,31,.55);border:1px solid rgba(224,138,95,.35);color:var(--text-strong)}.owner-main{flex:999 1 560px;min-width:0;padding:36px 44px}h1{font-size:38px;line-height:1.1;letter-spacing:-.03em;color:var(--text-strong)}h2{font-size:16px}.owner-eyebrow,.label{font-size:12px;color:var(--text-muted)}.panel,.card{background:rgba(78,14,31,.28);border:1px solid rgba(150,32,66,.45);border-radius:18px;padding:20px}.card-highlight{background:rgba(78,14,31,.5);border-color:rgba(224,138,95,.45);box-shadow:0 0 40px rgba(224,138,95,.14)}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%}th{font-size:12px;color:var(--text-muted);text-align:left}td,th{padding:12px;border-bottom:1px solid rgba(150,32,66,.16)}button,.button{border:0;border-radius:12px;padding:10px 14px;background:linear-gradient(180deg,var(--copper),var(--copper-dark));color:#1A0810;font:inherit;font-weight:700}a{color:var(--copper-light)}button:disabled{opacity:.55}.chip{display:inline-flex;border:1px solid rgba(150,32,66,.45);border-radius:999px}.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--copper);box-shadow:0 0 10px var(--copper)}.danger-zone{border:1px solid rgba(255,140,140,.35);background:rgba(60,10,14,.55);border-radius:18px}.owner-service{margin-top:32px;padding:16px;background:rgba(26,8,16,.78);border:1px solid rgba(150,32,66,.35);border-radius:18px}
@media(max-width: 390px){.owner-layout{flex-wrap:wrap;padding:16px}.owner-sidebar{flex:1 1 100%;max-width:none}.owner-nav{flex-direction:row;overflow-x:auto;white-space:nowrap}.owner-main{flex:1 1 100%;padding:16px}.card-grid{grid-template-columns:1fr}.table-scroll{overflow-x:auto}}
</style></head><body><div class="owner-layout"><aside class="owner-sidebar"><div class="brand"><span class="brand-mark" aria-hidden="true">◇</span>AI Bridge</div><p class="owner-eyebrow">Owner console</p><nav class="owner-nav" aria-label="Owner navigation"><a href="/owner/clients" aria-current="location">Clients</a><a href="/owner/measurements?format=html">Measurements</a><a href="/owner/exports">Exports</a><a href="/owner/blob-gc">Blob collection</a></nav><section class="owner-service"><h2>Service</h2><p><span class="status-dot" aria-hidden="true"></span> Service metadata unknown</p></section></aside><main class="owner-main"><p class="owner-eyebrow">Clients / id&lt;&amp;</p><h1>Client grants</h1><div class="table-scroll"><table><thead><tr><th>Grant</th><th>Registry state</th><th>Provider cleanup</th></tr></thead><tbody><tr><td>grant&lt;&amp;</td><td><span class="chip">Active registry grant</span></td><td>provider cleanup not pending</td></tr><tr><td>grant-2</td><td><span class="chip">Revoked</span></td><td>provider cleanup pending</td></tr></tbody></table></div><a href="/owner/clients/id%3C%26/grants?cursor=a%26b">Next page</a></main></div></body></html>"
`;

exports[`owner page rendering > renders the shared owner shell 1`] = `
