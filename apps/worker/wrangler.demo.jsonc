{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-bridge-m8-synthetic-local-only",
  "main": "src/demo/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "dev": { "ip": "127.0.0.1", "port": 8789 },
  "r2_buckets": [
    {
      "binding": "DEMO_BUCKET",
      "bucket_name": "ai-bridge-m8-synthetic-local-only",
      "remote": false
    }
  ]
}
