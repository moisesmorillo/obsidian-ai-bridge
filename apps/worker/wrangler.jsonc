{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-ai-bridge-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "secrets": {
    "required": ["OBSIDIAN_BRIDGE_CREDENTIAL_REGISTRY"]
  },
  "vars": {
    "OBSIDIAN_BRIDGE_AUTH_MODE": "credential-registry",
    "MIRROR_ASSOCIATION_ID": "11111111-1111-4111-8111-111111111111",
    "MIRROR_WRITER_ID": "22222222-2222-4222-8222-222222222222"
  },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "obsidian-ai-bridge-dev"
    }
  ]
}
