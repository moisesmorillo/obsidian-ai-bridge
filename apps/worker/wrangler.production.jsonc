{
	"name": "vaultwire",
	"account_id": "cb1688e69610249def9ac8e0448d5040",
	"compatibility_date": "2025-07-12",
	"compatibility_flags": ["unhandled_rejection_after_microtask_checkpoint"],
	"main": "src/index.ts",
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	"workers_dev": false,
	"triggers": { "crons": ["0 * * * *"] },
	"preview_urls": false,
	"vars": {
		"SERVICE_ORIGIN": "https://vaultwire.mmorillo.dev",
		"ACCESS_TEAM_DOMAIN": "https://mmorillo.cloudflareaccess.com",
		"ACCESS_AUDIENCE": "PENDING_S17_VAULTWIRE_ACCESS_AUDIENCE"
	},
	"durable_objects": {
		"bindings": [{ "name": "VAULTS", "class_name": "Vault" }]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "PENDING_S17_VAULTWIRE_OAUTH_KV_ID"
		}
	],
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "vaultwire-blobs" },
		{ "binding": "BACKUP_BUCKET", "bucket_name": "vaultwire-backups" }
	],
	"migrations": [
		{
			"tag": "vaultwire-transfer-v1",
			"transferred_classes": [
				{
					"from": "Vault",
					"from_script": "obsidian-ai-bridge",
					"to": "Vault"
				}
			]
		}
	]
}
