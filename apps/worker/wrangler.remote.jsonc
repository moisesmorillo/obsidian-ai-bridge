{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-bridge-m8-remote-synthetic",
  "main": "src/remote/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "r2_buckets": [
    {
      "binding": "REMOTE_BUCKET",
      "bucket_name": "ai-bridge-m8-remote-synthetic",
      "remote": false
    }
  ]
}
