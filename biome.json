{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": ["**", "!.superpowers", "!**/dist", "!**/.vitest"]
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["./*", "../*"],
								"message": "Use workspace-local import aliases."
							}
						]
					}
				}
			}
		}
	}
}
