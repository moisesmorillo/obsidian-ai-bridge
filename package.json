{
	"name": "obsidian-ai-bridge",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling"
	],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "bun run --filter '@obsidian-ai-bridge/*' typecheck",
		"test": "bun run --filter '@obsidian-ai-bridge/*' test",
		"build": "bun run --filter '@obsidian-ai-bridge/*' build",
		"docs:check": "bun tooling/check-documentation.ts",
		"check": "bun run lint && bun run docs:check && bun run typecheck && bun run test && bun run build"
	},
	"devDependencies": {
		"@ast-grep/napi": "0.51.0",
		"@biomejs/biome": "2.5.15",
		"@microsoft/tsdoc": "0.17.1",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	}
}
