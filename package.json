{
	"name": "obsidian-ai-bridge",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "bun run --filter '@obsidian-ai-bridge/*' typecheck",
		"test": "bun run --filter '@obsidian-ai-bridge/*' test",
		"build": "bun run --filter '@obsidian-ai-bridge/*' build",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	}
}
