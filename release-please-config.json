{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "extra-files": [
    {
      "type": "json",
      "path": "package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "apps/obsidian-plugin/package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "apps/obsidian-plugin/manifest.json",
      "jsonpath": "$.version"
    }
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Testing"
    },
    {
      "type": "build",
      "section": "Build"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "obsidian-ai-bridge"
    }
  }
}
